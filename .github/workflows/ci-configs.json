{
  "defaults": {
    "cache": false,
    "stormSource": "system",
    "storm_tag": "master",
    "carl_tag": "master",
    "extras": "[test,parser,plot]",
    "disable_all": false,
    "setupArgs": "",
    "testPaths": "",
    "allowIncompatible": false,
    "checkDocs": false,
    "expectNotHave": []
  },
  "linuxTests": [
    {
      "name": "Storm master, all libraries",
      "buildTypes": {
        "quick": [
          "Debug",
          "Release"
        ],
        "normal": [
          "Debug",
          "Release"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "baseImg": {
        "Debug": "movesrwth/storm:ci-debug",
        "Release": "movesrwth/storm:ci"
      },
      "checkDocs": true
    },
    {
      "name": "Storm master, no libraries",
      "buildTypes": {
        "normal": [
          "Release"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "baseImg": {
        "Debug": "movesrwth/storm:ci-debug",
        "Release": "movesrwth/storm:ci"
      },
      "extras": "[test]",
      "disable_all": true,
      "testPaths": "tests",
      "expectNotHave": [
        "DFT",
        "GSPN",
        "PARS",
        "POMDP"
      ]
    },
    {
      "name": "Storm stable",
      "buildTypes": {
        "quick": [
          "Debug",
          "Release"
        ],
        "normal": [
          "Debug",
          "Release"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "baseImg": {
        "Debug": "movesrwth/storm:stable-debug",
        "Release": "movesrwth/storm:stable"
      },
      "allowIncompatible": true
    },
    {
      "name": "Ubuntu 24.04 (fetch)",
      "cache": true,
      "buildTypes": {
        "normal": [
          "Debug"
        ],
        "extensive": [
          "Debug",
          "Release"
        ]
      },
      "baseImg": "movesrwth/storm-basesystem:ubuntu-24.04",
      "stormSource": "fetch"
    },
    {
      "name": "Ubuntu 24.04 (fetch), only Storm core",
      "buildTypes": {
        "extensive": [
          "Debug"
        ]
      },
      "baseImg": "movesrwth/storm-basesystem:ubuntu-24.04",
      "stormSource": "fetch",
      "extras": "[test]",
      "disable_all": true,
      "testPaths": "tests",
      "expectNotHave": [
        "DFT",
        "GSPN",
        "PARS",
        "POMDP"
      ]
    },
    {
      "name": "Debian 12 (fetch)",
      "buildTypes": {
        "extensive": [
          "Debug"
        ]
      },
      "baseImg": "movesrwth/storm-basesystem:debian-12",
      "stormSource": "fetch"
    },
    {
      "name": "Debian 13 (fetch)",
      "buildTypes": {
        "extensive": [
          "Debug"
        ]
      },
      "baseImg": "movesrwth/storm-basesystem:debian-13",
      "stormSource": "fetch"
    },
    {
      "name": "Ubuntu 26.04 (fetch)",
      "buildTypes": {
        "extensive": [
          "Debug"
        ]
      },
      "baseImg": "movesrwth/storm-basesystem:ubuntu-26.04",
      "stormSource": "fetch"
    }
  ],
  "macTests": [
